# ============================================================================
# AuctionChain — Environment Variables Configuration (.env)
# Copy this file to `.env` in the root directory:
#   cp .env.example .env   (macOS / Linux)
#   copy .env.example .env (Windows)
# ============================================================================

# 1. Server Port (Default: 3000 for Web3 Frontend & Gateway)
PORT=3000

# 2. AI Vehicle Valuation Service Key (Optional)
# If left as placeholder or empty, AuctionChain automatically uses its built-in
# deterministic Indian Vehicle Market Valuation Engine (₹ INR).
GEMINI_API_KEY=your_api_key_here

